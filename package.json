    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.24.2",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.1.7",
    "postcss": "^8.5.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.10",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
